# =================================================================
# Indian Legal Precedents RAG - server configuration (.env)
# CPU-only plan (CLAUDE.md §3). Use ABSOLUTE paths on the server.
# Never commit the real .env.
# =================================================================

# -----------------------------------------------------------------
# 1. Resources (hard limit 20 GB for everything together)
# -----------------------------------------------------------------
MAX_RAM_GB=18               # process-tree RSS (parent + extraction workers)
WARN_RAM_GB=15
MAX_STORAGE_GB=0            # 0 = no storage walk (NFS home, 13 TB free)
NUM_THREADS=14              # torch threads at query time (16 cores)
INDEX_TORCH_THREADS=12      # torch threads while indexing (leaves cores for extraction workers)
EXTRACT_WORKERS=4           # spawned PDF extraction processes (no torch inside)
EMBED_BATCH_SIZE=64
VRAM_SAFETY_FRACTION=0.85   # only used if a GPU is ever available
CUDNN_ENABLED=false

# -----------------------------------------------------------------
# 2. Models (CLAUDE.md D4)
# -----------------------------------------------------------------
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QUERY_INSTRUCTION=auto      # auto = BGE query prefix; documents never get a prefix
RERANKER_MODEL=BAAI/bge-reranker-base
AUTHORITY_STRENGTH=0.1      # 0 = authority prior off (ablation)
AUTHORITY_MAX_BONUS=0.05

# -----------------------------------------------------------------
# 3. Paths (absolute on the server; everything outside the git folder)
# -----------------------------------------------------------------
METADATA_DIR=/home/<user>/Pratik/workspace/data/metadata
RAW_DATA_DIR=/home/<user>/Pratik/workspace/data
PROCESSED_DATA_DIR=/home/<user>/Pratik/workspace/store/processed
CHROMA_DB_DIR=/home/<user>/Pratik/workspace/store/chromadb
SQLITE_DB_PATH=/home/<user>/Pratik/workspace/store/parent_store.db     # one <collection>.sqlite per collection next to it
CHECKPOINT_PATH=/home/<user>/Pratik/workspace/store/indexing_checkpoint.json   # checkpoint_<collection>.json next to it
PARENT_STORE_DIR=/home/<user>/Pratik/workspace/store/parent_store
BENCHMARKS_DIR=/home/<user>/Pratik/workspace/benchmarks
LOGS_DIR=/home/<user>/Pratik/workspace/logs
HF_HOME=/home/<user>/Pratik/workspace/hf_cache
COLLECTION_NAME=sc_criminal_cpu
WRITE_PARENT_JSON=false

# -----------------------------------------------------------------
# 4. Chunking (CLAUDE.md D5, characters)
# -----------------------------------------------------------------
PARENT_CHUNK_SIZE=2000
CHILD_CHUNK_SIZE=800
CHUNK_OVERLAP=120

# -----------------------------------------------------------------
# 5. LLM (every call goes through src/llm_budget.py, cached)
# -----------------------------------------------------------------
SYNTHESIS_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2000
LLM_RPM=20
LLM_FALLBACK_MODELS=openai/gpt-oss-20b
LOCAL_LLM_FALLBACK=false    # keep false: a 7B model in fp32 on CPU needs ~30 GB
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
