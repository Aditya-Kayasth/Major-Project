# =================================================================
# INDIAN LEGAL RAG - PRODUCTION SERVER CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. HARDWARE & RESOURCE GUARDRAILS (Strict Limits for Safe Operation)
# -----------------------------------------------------------------
MAX_RAM_GB=20.0             # Strict process RAM ceiling (prevents cgroup 64GB OOM kill)
WARN_RAM_GB=16.0            # Memory threshold that triggers emergency GC and cooldown
MAX_STORAGE_GB=30.0         # Monitored storage cap for models, ChromaDB, and SQLite
VRAM_SAFETY_FRACTION=0.85   # Caps PyTorch allocation to ~38.5 GB on 45 GB Blackwell B200
NUM_THREADS=8               # CPU threads for document parsing and vector calculations

# -----------------------------------------------------------------
# 2. NEURAL EMBEDDINGS (Local zembed-1 vs. Cloud Gemini)
# -----------------------------------------------------------------
# Options: 'local' (zero API keys, runs on B200) or 'gemini' (API based)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=zeroentropy/zembed-1
# Fallback local models: 'BAAI/bge-base-en-v1.5' or 'BAAI/bge-small-en-v1.5'
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# -----------------------------------------------------------------
# 3. NEURAL CROSS-ENCODER RERANKER
# -----------------------------------------------------------------
# High-precision Cross-Encoder evaluated in FP16/BF16 on B200
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# -----------------------------------------------------------------
# 4. STORAGE & VECTOR COLLECTIONS (Persistent NFS Storage)
# -----------------------------------------------------------------
CHROMA_DB_DIR=chromadb_store
COLLECTION_NAME=indian_legal_precedents
SQLITE_DB_PATH=data/parent_store.db
CHECKPOINT_PATH=data/processed/indexing_checkpoint.json
PARENT_STORE_DIR=data/parent_store
RAW_DATA_DIR=data/raw_judgments
PROCESSED_DATA_DIR=data/processed
BENCHMARKS_DIR=data/benchmarks

# -----------------------------------------------------------------
# 5. 3-TIER HIERARCHICAL LEGAL CHUNKING HYPERPARAMETERS
# -----------------------------------------------------------------
PARENT_CHUNK_SIZE=1500      # Macro judicial sections (Analysis, Rulings)
CHILD_CHUNK_SIZE=400        # Granular vectors with prepended role tags
CHUNK_OVERLAP=80            # Sliding window token overlap

# -----------------------------------------------------------------
# 6. LLM SYNTHESIS & JUDGE (Optional: Gemini or Local Ollama)
# -----------------------------------------------------------------
# Options: 'gemini' or 'ollama'
SYNTHESIS_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# If using local Ollama on the server (running at localhost:11434):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------
# 7. KAGGLE DATASET DOWNLOAD (Optional for automated pull)
# -----------------------------------------------------------------
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key
