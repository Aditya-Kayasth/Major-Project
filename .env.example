# =================================================================
# INDIAN LEGAL RAG - PRODUCTION SERVER CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. HARDWARE & RESOURCE GUARDRAILS (Strict Limits for Safe Operation)
# -----------------------------------------------------------------
MAX_RAM_GB=24.0             # Strict process RAM ceiling (stay inside the ~30 GB allocation)
WARN_RAM_GB=20.0            # Memory threshold that triggers emergency GC and cooldown
MAX_STORAGE_GB=30.0         # Monitored storage cap for models, ChromaDB, and SQLite
VRAM_SAFETY_FRACTION=0.85   # Caps PyTorch allocation to ~38.5 GB on 45 GB Blackwell B200
NUM_THREADS=8               # CPU threads for document parsing and vector calculations
CUDNN_ENABLED=false         # cuDNN fails to initialise on the B200 MIG slice; transformers run fine without it

# -----------------------------------------------------------------
# 2. NEURAL EMBEDDINGS (Local zembed-1 vs. Cloud Gemini)
# -----------------------------------------------------------------
# Options: 'local' (zero API keys, runs on B200) or 'gemini' (API based)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=zeroentropy/zembed-1
# Fallback local models: 'BAAI/bge-base-en-v1.5' or 'BAAI/bge-small-en-v1.5'
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# -----------------------------------------------------------------
# 3. NEURAL CROSS-ENCODER RERANKER
# -----------------------------------------------------------------
# High-precision Cross-Encoder evaluated in FP16/BF16 on B200
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Stare Decisis / role authority prior, applied as a bounded tie-breaker:
#   factor = 1 + clamp(AUTHORITY_STRENGTH * ln(multiplier), +/- AUTHORITY_MAX_BONUS)
# Set AUTHORITY_STRENGTH=0 for a pure-relevance ablation.
AUTHORITY_STRENGTH=0.1
AUTHORITY_MAX_BONUS=0.05

# -----------------------------------------------------------------
# 4. STORAGE & VECTOR COLLECTIONS (Persistent NFS Storage)
# -----------------------------------------------------------------
CHROMA_DB_DIR=chromadb_store
COLLECTION_NAME=indian_legal_precedents
SQLITE_DB_PATH=data/parent_store.db
CHECKPOINT_PATH=data/processed/indexing_checkpoint.json
PARENT_STORE_DIR=data/parent_store
WRITE_PARENT_JSON=false     # legacy one-JSON-file-per-parent backup (slow on NFS); SQLite is the source of truth
RAW_DATA_DIR=data/raw_judgments
PROCESSED_DATA_DIR=data/processed
BENCHMARKS_DIR=data/benchmarks

# -----------------------------------------------------------------
# 5. 3-TIER HIERARCHICAL LEGAL CHUNKING HYPERPARAMETERS
# -----------------------------------------------------------------
PARENT_CHUNK_SIZE=1500      # Macro judicial sections (Analysis, Rulings)
CHILD_CHUNK_SIZE=400        # Granular vectors with prepended role tags
CHUNK_OVERLAP=80            # Sliding window token overlap

# -----------------------------------------------------------------
# 6. LLM SYNTHESIS & JUDGE (Optional: Gemini or Local Ollama)
# -----------------------------------------------------------------
# Primary LLM for answers, judging and benchmark generation:
#   'openai' = any OpenAI-compatible API below (Groq recommended: free key at console.groq.com)
#   'gemini' = Google Gemini   |   'local' = open-weights model on this GPU
# Other configured providers are used automatically as fallbacks.
SYNTHESIS_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4000
LLM_RPM=20
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b   # separate rate limits per model on Groq
# Examples: Cerebras https://api.cerebras.ai/v1 | OpenRouter https://openrouter.ai/api/v1
LOCAL_LLM_FALLBACK=false
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# If using local Ollama on the server (running at localhost:11434):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------
# 7. KAGGLE DATASET DOWNLOAD (Optional for automated pull)
# -----------------------------------------------------------------
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key
